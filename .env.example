# Alpaca paper trading credentials (fill locally, never commit real values)
ALPACA_KEY=your_alpaca_key_id
ALPACA_SECRET=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_URL=https://data.alpaca.markets

# AI router configuration (OpenRouter)
AI_ROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ROUTER_API_KEY=your_openrouter_api_key
AI_ROUTER_MODEL=openai/gpt-4o-mini

# Fallback LLM provider
LLM_FALLBACK_BASE_URL=https://20a324a2313f.nofx.one
LLM_FALLBACK_API_KEY=your_fallback_llm_api_key
LLM_FALLBACK_MODEL=z-ai/glm-5.3-free
# AI Trading Bot & Autonomous Scheduler
BOT_AUTONOMOUS_ENABLED=true
BOT_SCHEDULE_INTERVAL_HOURS=1
BOT_EXECUTE_ORDERS=false
BOT_UNIVERSE=AAPL,MSFT,NVDA,TSLA,SPY,QQQ,JPM,KO

# AI Intelligence & Model Configuration
AI_AGENT_MODE=hybrid
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Alpaca MCP Server Integration
ALPACA_MCP_ENABLED=true

# Security & Network
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET_KEY=autooverlay-demo-salt-2026
